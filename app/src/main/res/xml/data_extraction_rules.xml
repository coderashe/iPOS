<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude database and sensitive prefs from cloud backup; allow DB in device-to-device transfer -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="device_prefs.xml" />
        <exclude domain="sharedpref" path="ipos_prefs.xml" />
        <exclude domain="sharedpref" path="setup_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="ipos_prefs.xml" />
    </device-transfer>
</data-extraction-rules>