<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- App-specific Documents folder -->
    <external-files-path name="documents" path="Documents/" />
    <!-- Internal files/images folder -->
    <files-path name="my_images" path="images/" />
    <!-- Cache subfolder -->
    <cache-path name="my_images" path="images/" />
    <!-- Cache root — covers temp files written directly to cacheDir (camera) -->
    <cache-path name="cache_root" path="." />
</paths>
